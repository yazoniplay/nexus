# Copy to backend/.env. Never commit real credentials.
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4:31b

# GitHub App OAuth (create a GitHub App, enable user authorization, and request least privilege)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/github/callback
FRONTEND_URL=http://127.0.0.1:5500
NEXUS_SESSION_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_ENCRYPTION_KEY=

# Supabase backend-only credentials. Never expose service role key to the browser.
SUPABASE_URL=https://kuvyaytptnghopqbykab.supabase.co
